<!--
  Shared Android Lint configuration, applied to every module from
  build-logic/src/main/kotlin/com/android254/Lint.kt.

  There is no baseline file, on purpose. A baseline freezes today's violations into a blob
  nobody reads; the one this project used to carry was generated by lint 8.10.1, listed a
  contributor's home directory, and 52 of its 66 entries were dependency-version notices that
  had long since stopped being true.

  Severity instead says what the project means:

    error         Enforced. The build fails. Every one of these is currently clean.
    warning       Real, reported, and being burned down. Shows in the IDE and in CI reports.
    informational Reported but not acted on, with the reason written down.

  Raising a rule from warning to error is the last commit of the work that clears it.
  See docs/static-analysis.md for the current counts.
-->
<lint>

    <!-- ===================================================================================
         Slack Compose lint rules — com.slack.lint.compose:compose-lint-checks

         Applied to every Android module (see Lint.kt for why it is not just the Compose
         ones). Rules the codebase already satisfies are enforced; the rest are visible.
         =================================================================================== -->

    <!-- Enforced: correctness. Each of these is a bug, not a style preference. -->
    <issue id="ComposeRememberMissing" severity="error" />
    <issue id="ComposeMutableParameters" severity="error" />
    <issue id="ComposeContentEmitterReturningValues" severity="error" />
    <issue id="ComposeViewModelForwarding" severity="error" />
    <issue id="ComposeItemKeyHashCode" severity="error" />
    <issue id="ComposeUnstableReceiver" severity="error" />

    <!-- Enforced: API shape the project already follows. -->
    <issue id="ComposeNamingUppercase" severity="error" />
    <issue id="ComposeNamingLowercase" severity="error" />
    <issue id="ComposeModifierComposed" severity="error" />

    <!--
      Enforced: chai is the design system and Material 3 is the target. This is the rule that
      keeps a stray androidx.compose.material import from re-entering the tree.
    -->
    <issue id="ComposeM2Api" severity="error" />

    <!--
      Being burned down. These are all genuine, and fixing them means changing composable
      signatures and every call site, which is its own change rather than a line in a
      housekeeping branch. Counts at the time of writing are in docs/static-analysis.md.
    -->
    <issue id="ComposeModifierMissing" severity="warning" />
    <issue id="ComposeModifierWithoutDefault" severity="warning" />
    <issue id="ComposeModifierReused" severity="warning" />
    <issue id="ComposeParameterOrder" severity="warning" />
    <issue id="ComposeUnstableCollections" severity="warning" />
    <issue id="ComposeMultipleContentEmitters" severity="warning" />
    <issue id="ComposeViewModelInjection" severity="warning" />
    <issue id="ComposePreviewPublic" severity="warning" />
    <issue id="ComposePreviewNaming" severity="warning" />
    <issue id="ComposeRedundantComposable" severity="warning" />

    <!--
      CompositionLocal is how a design system publishes its palette and typography, which is
      exactly the case this rule cannot tell apart from abuse. Enforced everywhere except the
      chai colour and typography roots that do the publishing.

      Matched by regexp rather than `path`: the same file is analysed once as part of :chai
      and again as part of :app's checkDependencies run, and the two see different path
      prefixes.
    -->
    <issue id="ComposeCompositionLocalUsage" severity="error">
        <ignore regexp="chai/colors/ChaiColors\.kt" />
        <ignore regexp="chai/atoms/.*\.kt" />
    </issue>

    <!-- ===================================================================================
         Platform checks
         =================================================================================== -->

    <!--
      Dependency freshness is not lint's job here: `./gradlew dependencyUpdates` reports it on
      demand and Dependabot opens the PRs. Left on as errors, every module's lint run breaks
      the day a transitive dependency ships a patch release.
    -->
    <issue id="GradleDependency" severity="informational" />
    <issue id="AndroidGradlePluginVersion" severity="informational" />
    <issue id="NewerVersionAvailable" severity="informational" />
    <issue id="SimilarGradleDependency" severity="informational" />

    <!-- One flavour, one store listing, and the organisers translate outside this repo. -->
    <issue id="MissingTranslation" severity="informational" />
    <issue id="ExtraTranslation" severity="informational" />

    <!--
      The rule is about icons. These are full-bleed background illustrations and headers,
      which are correctly vectors and are correctly larger than 200x200 — rasterising them
      per density is the worse trade.
    -->
    <issue id="VectorRaster" severity="informational" />

    <!--
      Photographic assets — speaker headshots, event banners, feedback faces — in `drawable/`
      rather than a density bucket. Right call for a single artwork scaled to fit; wrong call
      for an icon. Worth revisiting with the asset pipeline, not by moving files blind.
    -->
    <issue id="IconLocation" severity="informational" />

</lint>
