<?xml version="1.0" encoding="utf-8"?>
<!--
  Colours for the platform surfaces that cannot read a Compose theme: the splash screen and
  the notification accent. Everything drawn by Compose takes its colours from
  MaterialTheme.chaiColorsPalette instead — see the chai module.
-->
<resources>
    <color name="cyan">#00E2C3</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="splash_screen_background">#FFFFFF</color>
</resources>
