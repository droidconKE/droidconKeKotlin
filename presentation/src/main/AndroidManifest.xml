<?xml version="1.0" encoding="utf-8"?>
<!--
  The messaging service is declared here rather than in the app manifest because this is the
  module that owns the class and depends on firebase-messaging. Declaring it in :app left
  lint unable to resolve FirebaseMessagingService through an `implementation` dependency, so
  it reported the service as not extending android.app.Service. Manifest merging folds this
  into the application manifest unchanged.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <service
            android:name="com.android254.presentation.notifications.MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
